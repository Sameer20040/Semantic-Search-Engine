# ---------------------------------------------------------------------------
# Copy to `.env` and edit. NEVER commit a filled-in .env.
# Every variable below maps to a field in semantic_search.core.config.Settings
# (see src/semantic_search/core/config.py) and can be overridden by YAML.
# ---------------------------------------------------------------------------

# --- Application ---
APP_NAME="Semantic Search Engine"
SSE_ENV=development          # development | production
SSE_VERSION=0.1.0
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console            # console | json

# --- Data directories (relative paths resolve against PROJECT_ROOT) ---
SSE_DATA_DIR=data
CORPUS_SIZE=small             # small | medium | full
DATASET_NAME=wikimedia/wikipedia
DATASET_CONFIG=20231101.en

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=auto         # auto | cpu | cuda
EMBEDDING_BATCH_SIZE=64
EMBEDDING_MAX_SEQ_LENGTH=256
EMBEDDING_NORMALIZE=true

# --- FAISS ---
FAISS_INDEX_TYPE=flat_ip      # flat_ip | flat_l2 | ivf_flat | hnsw
FAISS_HNSW_M=32
FAISS_IVF_NLIST=1024
FAISS_IVF_NPROBE=16

# --- BM25 ---
BM25_K1=1.5
BM25_B=0.75
BM25_MIN_TOKEN_LENGTH=2
BM25_USE_STEMMING=true
BM25_STOPWORDS=en

# --- Hybrid / RRF ---
RRF_K=60
DEFAULT_SEARCH_METHOD=hybrid # bm25 | semantic | hybrid
DEFAULT_TOP_K=10
MAX_TOP_K=100

# --- Query processing ---
# QUERY_ENABLED=false bypasses processing entirely (equivalent to search_raw).
QUERY_ENABLED=true
# Spell correction is OFF by default: measured against the 300-doc corpus it
# mangles out-of-corpus real words as often as it fixes typos. See BUILD_STATUS.md
# Phase 8 before turning this on.
QUERY_SPELL_CHECK=false
QUERY_MIN_CORRECTION_SCORE=80.0
QUERY_MIN_EDIT_DISTANCE=2
QUERY_MIN_CANDIDATE_DF=3
# Recorded always, applied only when true.
QUERY_SYNONYM_EXPANSION=false
QUERY_MAX_LENGTH=512
QUERY_PRESERVE_PROPER_NOUNS=true
# Refuse to correct a stopword in either direction ("and" -> "andy").
QUERY_PROTECT_STOPWORDS=true

# --- Application search service (Phase 9) ---
# Mirrors the search/query defaults above; the app layer adds no retrieval
# behaviour of its own. Names are derived from the config field names, so these
# work with no alias table.
APP_DEFAULT_TOP_K=10
# top_k above this is clamped rather than rejected, and the pre-clamp value is
# reported back in the response metadata.
APP_MAX_TOP_K=100
# The default for the three-way per-request choice; a request may still
# override it explicitly.
APP_QUERY_PROCESSING_ENABLED=true
APP_MAX_QUERY_CHARS=512

# --- Evaluation harness (Phase 10) ---
# These configure how the EVALUATION runs. No search code path reads them, so
# changing EVAL_DEPTH does not change what a user sees from a query.
EVAL_DEPTH=50
EVAL_RESAMPLES=10000
EVAL_SEED=20250930
# Opt-in. Runs the spell-correction arm as a LABELLED EXPERIMENT; it does NOT
# change QUERY_SPELL_CHECK for production traffic.
EVAL_RUN_SPELL_EXPERIMENT=false

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_CORS_ORIGINS=*             # comma-separated origins, or * for any
API_RATE_LIMIT_PER_MINUTE=60
API_RATE_LIMIT_ENABLED=true
API_CACHE_SIZE=512
API_CACHE_TTL_SECONDS=300
API_MAX_PAYLOAD_BYTES=262144
API_EXPOSE_STACK_TRACES=false
API_LOG_QUERIES=false          # never enable on a public deployment

# --- Logging / observability ---
LOG_QUERIES=false
CACHE_BACKEND=memory           # memory | disk

# --- Frontend (Streamlit) ---
# Read by app/utils/api.py. The UI talks to the API over HTTP and holds no
# retrieval code of its own, so this is the only thing that decides which
# backend the page searches.
STREAMLIT_API_BASE_URL=http://localhost:8000
STREAMLIT_SERVER_PORT=8501
