# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# --- Test / tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.benchmarks/

# --- Secrets & local config ---
.env
.env.local
*.pem
secrets/

# --- Data & index artifacts (never commit; see docs/deployment.md) ---
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/index/*
!data/index/.gitkeep
data/evaluation/derived/*
!data/evaluation/derived/.gitkeep
*.faiss
*.npy
*.bin
*.pkl
*.npz
*.model

# --- Streamlit ---
.streamlit/secrets.toml

# --- Editors / OS ---
.idea/
.vscode/
!.vscode/extensions.json
.DS_Store
Thumbs.db
*.swp
